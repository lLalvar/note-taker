# Private environment variables (never exposed to client)
SENTRY_AUTH_TOKEN=your_sentry_auth_token
RESEND_API_KEY=your_resend_api_key

# Public environment variables (exposed to client; prefix with EXPO_PUBLIC_)
EXPO_PUBLIC_CLOUDFLARE_WORKER_URL=https://note-taker-api.your-subdomain.workers.dev

# Legal site base URL (for sitemap and generated meta tags)
LEGAL_SITE_URL=https://yourdomain.com